VITE_PORTAL_LOGO=/images/logo.svg

# API base URL – override in .env.local (never commit real values)
VITE_API_BASE_URL=http://localhost:3000/api

# Keycloak – override in .env.local with your realm values
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=cgp
VITE_KEYCLOAK_CLIENT_ID=ats-module

# i18n – override in .env.local with supported languages
VITE_LANG=en
VITE_FALLBACK_LANG=en

VITE_FRONTEND_BASE_URL=http://localhost:4173