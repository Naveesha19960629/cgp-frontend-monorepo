FROM node:20-alpine AS builder

# Build arguments
ARG VITE_ATS_MODULE_URL
ARG VITE_PORTAL_LOGO
ARG VITE_API_BASE_URL
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_BACKEND_API_URL
ARG VITE_BACKEND_API_VERSION
ARG VITE_LANG
ARG VITE_FALLBACK_LANG
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM
ARG VITE_KEYCLOAK_CLIENT_ID
ARG VITE_ATS_MODULE_FRONTEND_BASE_URL=/

# Set as environment variables for Vite
ENV VITE_ATS_MODULE_URL=$VITE_ATS_MODULE_URL
ENV VITE_PORTAL_LOGO=$VITE_PORTAL_LOGO
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_BACKEND_API_URL=$VITE_BACKEND_API_URL
ENV VITE_BACKEND_API_VERSION=$VITE_BACKEND_API_VERSION
ENV VITE_LANG=$VITE_LANG
ENV VITE_FALLBACK_LANG=$VITE_FALLBACK_LANG
ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL
ENV VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
ENV VITE_ATS_MODULE_FRONTEND_BASE_URL=$VITE_ATS_MODULE_FRONTEND_BASE_URL

RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml* ./
COPY nx.json ./
COPY pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN pnpm install --frozen-lockfile

ENV NX_DAEMON=false

RUN pnpm nx build cooperate-portal-shell

# Inject runtime config
RUN sed "s|__VITE_ATS_MODULE_URL__|$VITE_ATS_MODULE_URL|g" \
    apps/cooperate-portal-shell/public/runtime-config.js \
    > apps/cooperate-portal-shell/dist/runtime-config.js

FROM nginx:alpine

COPY --from=builder /app/apps/cooperate-portal-shell/dist/ /usr/share/nginx/html/

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]